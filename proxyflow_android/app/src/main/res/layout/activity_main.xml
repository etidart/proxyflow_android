<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_disconnected"
        android:textSize="18sp"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/lastDownloadText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/last_download_never"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/proxySourceButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/choose_proxy_source"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/downloadButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/download_proxy_list"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/vpnButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/connect" />
</LinearLayout>
